Config(
    prefix: "",
    max_entries: 3,
    actions: [
        Action(
            title: "Lock screen",
            description: Some("Lock the screen"),
            keywords: ["lock screen"],
            icon: Some("system-lock-screen"),
            command: "loginctl",
            args: ["lock-session"],
            confirm: false,
        ),
        Action(
            title: "Log out",
            description: Some("Log out of this session"),
            keywords: ["end session", "log out"],
            icon: Some("system-log-out"),
            command: "uwsm",
            args: ["stop"],
            confirm: true,
        ),
        Action(
            title: "Power off",
            description: Some("Power off the device"),
            keywords: [
                "power off",
                "shut down",
                "turn off",
            ],
            icon: Some("system-shutdown"),
            command: "systemctl",
            args: ["poweroff"],
            confirm: true,
        ),
        Action(
            title: "Restart",
            description: Some("Restart the device"),
            keywords: ["reboot", "restart"],
            icon: Some("system-reboot"),
            command: "systemctl",
            args: ["reboot"],
            confirm: true,
        ),
        Action(
            title: "Restart to UEFI",
            description: Some("Restart and enter the UEFI"),
            keywords: [
                "bios",
                "firmware setup",
                "reboot to",
                "restart to",
                "uefi",
            ],
            icon: Some("preferences-system"),
            command: "systemctl",
            args: ["reboot", "--firmware-setup"],
            confirm: true,
        ),
        Action(
            title: "Sleep",
            description: Some("Put the device on stand-by"),
            keywords: [
                "hibernate",
                "sleep",
                "stand by",
                "suspend",
            ],
            icon: Some("system-suspend"),
            command: "systemctl",
            args: ["sleep"],
            confirm: false,
        ),
        Action(
            title: "Switch User",
            description: Some("Show the login screen"),
            keywords: [
                "log in",
                "switch session",
                "switch user",
            ],
            icon: Some("system-switch-user"),
            command: "busctl",
            args: ["call", "org.gnome.DisplayManager", "/org/gnome/DisplayManager/LocalDisplayFactory", "org.gnome.DisplayManager.LocalDisplayFactory", "CreateTransientDisplay"],
            confirm: false,
        ),
    ]
)
